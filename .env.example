# Convex deployment URL — public, safe for client. Set automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Server-only. Used for `npx convex deploy` in CI/CD (Vercel build step).
CONVEX_DEPLOY_KEY=

# Convex environment variable, not a Next.js one — set via:
#   npx convex env set RESEND_API_KEY <value> --prod
# Documented here for visibility only; do not read it from process.env in Next.js code.
# Used by convex/notify.ts to tell the coach a lead arrived. Unset means no
# notification and no error. The message carries no candidate details, so no
# sending domain has to be verified: Resend's shared onboarding@resend.dev
# delivers to the account owner's own address, which is the only recipient.
# RESEND_API_KEY=

# PostHog analytics — must be configured with person_profiles: 'identified_only'
# and no autocapture of form input values (PRD § 2 Security Considerations).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry error tracking.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Restricts the single Convex Auth admin account. No public sign-up path exists.
ADMIN_EMAIL=

# Where the result page's consultation CTA points (TASK-046). The CTA is hidden
# entirely while this is unset, rather than shipping a button that goes nowhere.
NEXT_PUBLIC_BOOKING_URL=

# Local development only: skips the sign-in gate on /admin. Two switches, both
# required, and neither can be turned on globally.
#
#   NEXT_PUBLIC_DEV_ADMIN_BYPASS=1        here, in .env.local (gitignored)
#   npx convex env set DEV_ADMIN_BYPASS <deployment-name>
#
# The Convex one must NAME the deployment it is allowed on, and is compared
# against the deployment actually running the code, so copying it to production
# does nothing. Leave both unset everywhere except a local machine.
NEXT_PUBLIC_DEV_ADMIN_BYPASS=
